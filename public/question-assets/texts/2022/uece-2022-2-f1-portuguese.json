    {
      "id": "uece-2022-2-f1-portuguese-t2",
      "label": "Texto 2",
      "title": "LETRAS",
      "lines": [
        {
          "number": null,
          "text": "LYGIA FAGUNDES TELLES FOI A 3ª MULHER A"
        },
        {
          "number": null,
          "text": "INGRESSAR NA ACADEMIA BRASILEIRA DE"
        },
        {
          "number": 103,
          "text": "Livro Ciranda de Pedra, publicado em"
        },
        {
          "number": 104,
          "text": "1954, é considerado o início da sua"
        },
        {
          "number": 105,
          "text": "maturidade literária. Escritora morreu aos 98"
        },
        {
          "number": 106,
          "text": "anos em São Paulo."
        },
        {
          "number": 107,
          "text": "Lygia Fagundes Telles, nasceu em São"
        },
        {
          "number": 108,
          "text": "Paulo e foi criada no interior do estado."
        },
        {
          "number": 109,
          "text": "Voltou a morar na capital paulista na"
        },
        {
          "number": 110,
          "text": "adolescência, quando manifestou sua"
        },
        {
          "number": 111,
          "text": "vocação pela literatura. Ao atingir o que ela"
        },
        {
          "number": 112,
          "text": "considera sua maturidade literária, a"
        },
        {
          "number": 113,
          "text": "escritora rejeitou suas primeiras produções:"
        },
        {
          "number": 114,
          "text": "“a pouca idade não justifica o nascimento de"
        },
        {
          "number": 115,
          "text": "textos prematuros, que deveriam continuar"
        },
        {
          "number": 116,
          "text": "no limbo”, disse Lygia segundo sua biografia"
        },
        {
          "number": 117,
          "text": "na Academia Brasileira de Letras."
        },
        {
          "number": 118,
          "text": "O livro Ciranda de Pedra (1954) é"
        },
        {
          "number": 119,
          "text": "considerado por ela mesma o marco inicial de"
        },
        {
          "number": 120,
          "text": "suas obras completas. O romance serviu de"
        },
        {
          "number": 121,
          "text": "inspiração para uma novela de sucesso que"
        },
        {
          "number": 122,
          "text": "foi ao ar em 1981 na TV Globo, com uma"
        },
        {
          "number": 123,
          "text": "segunda versão em 2008."
        },
        {
          "number": 124,
          "text": "Seu segundo romance, Verão no"
        },
        {
          "number": 125,
          "text": "Aquário (1963), lhe rendeu seu primeiro"
        },
        {
          "number": 126,
          "text": "prêmio Jabuti. Depois ela recebeu outros"
        },
        {
          "number": 127,
          "text": "três, que se juntam a uma enorme lista de"
        },
        {
          "number": 128,
          "text": "premiações por suas obras."
        },
        {
          "number": 129,
          "text": "A década de 1970 foi de intensa"
        },
        {
          "number": 130,
          "text": "atividade literária e marca a sua consagração"
        },
        {
          "number": 131,
          "text": "na carreira. A escritora publicou alguns de"
        },
        {
          "number": 132,
          "text": "seus livros mais importantes: Antes do Baile"
        },
        {
          "number": 133,
          "text": "Verde (1970), As Meninas (1973), Seminário"
        },
        {
          "number": 134,
          "text": "dos Ratos (1977) e o livro de contos Filhos"
        },
        {
          "number": 135,
          "text": "Pródigos (1978)."
        },
        {
          "number": 136,
          "text": "De acordo com a ABL, a consagração"
        },
        {
          "number": 137,
          "text": "definitiva viria com o Prêmio Camões (2005),"
        },
        {
          "number": 138,
          "text": "distinção maior em língua portuguesa pelo"
        },
        {
          "number": 139,
          "text": "conjunto de obra."
        },
        {
          "number": 140,
          "text": "Lygia foi a terceira mulher a ingressar"
        },
        {
          "number": 141,
          "text": "na Academia Brasileira de Letras, em 1985."
        },
        {
          "number": 142,
          "text": "Além dela, tornaram-se imortais Rachel de"
        },
        {
          "number": 143,
          "text": "Queiroz (1977), Dinah Silveira de Queiroz"
        },
        {
          "number": 144,
          "text": "(1980), Nélida Piñon (1989), Zélia Gattai"
        },
        {
          "number": 145,
          "text": "(2001), Ana Maria Machado (2003), Cleonice"
        },
        {
          "number": 146,
          "text": "Berardinelli (2009), Rosiska Darcy de Oliveira"
        },
        {
          "number": 147,
          "text": "(2013) e, mais recentemente, Fernanda"
        },
        {
          "number": 148,
          "text": "Montenegro (2022)."
        },
        {
          "number": 149,
          "text": "Teve seus livros publicados em"
        },
        {
          "number": 150,
          "text": "diversos países: Portugal, França, Estados"
        },
        {
          "number": 151,
          "text": "Unidos, Alemanha, Itália, Holanda, Suécia e"
        },
        {
          "number": 152,
          "text": "Espanha, entre outros, com obras adaptadas"
        },
        {
          "number": 153,
          "text": "para TV, teatro e cinema."
        },
        {
          "number": null,
          "text": "Adaptado de https://g1.globo.com/pop-"
        },
        {
          "number": null,
          "text": "arte/noticia/2022/04/03/escritora-lygia-fagundes-telles-"
        },
        {
          "number": null,
          "text": "biografia.ghtml. Acesso em 03 de abril de 2022."
        }
      ],
