    {
      "id": "uece-2022-2-f1-portuguese-t3",
      "label": "Texto 3",
      "title": "Os sapos",
      "lines": [
        {
          "number": null,
          "text": "(Manuel Bandeira)"
        },
        {
          "number": 154,
          "text": "Enfunando os papos,"
        },
        {
          "number": 155,
          "text": "Saem da penumbra,"
        },
        {
          "number": 156,
          "text": "Aos pulos, os sapos."
        },
        {
          "number": 157,
          "text": "A luz os deslumbra."
        },
        {
          "number": 158,
          "text": "Em ronco que aterra,"
        },
        {
          "number": 159,
          "text": "Berra o sapo-boi:"
        },
        {
          "number": 160,
          "text": "– “Meu pai foi à guerra!”"
        },
        {
          "number": 161,
          "text": "– “Não foi!” – “Foi!” – “Não foi!”."
        },
        {
          "number": 162,
          "text": "O sapo-tanoeiro,"
        },
        {
          "number": 163,
          "text": "Parnasiano aguado,"
        },
        {
          "number": 164,
          "text": "Diz: – “Meu cancioneiro"
        },
        {
          "number": 165,
          "text": "É bem martelado."
        },
        {
          "number": 166,
          "text": "Vede como primo"
        },
        {
          "number": 167,
          "text": "Em comer os hiatos!"
        },
        {
          "number": 168,
          "text": "Que arte! E nunca rimo"
        },
        {
          "number": 169,
          "text": "Os termos cognatos."
        },
        {
          "number": 170,
          "text": "O meu verso é bom"
        },
        {
          "number": 171,
          "text": "Frumento sem joio."
        },
        {
          "number": 172,
          "text": "Faço rimas com"
        },
        {
          "number": 173,
          "text": "Consoantes de apoio."
        },
        {
          "number": 174,
          "text": "Vai por cinquenta anos"
        },
        {
          "number": 175,
          "text": "Que lhes dei a norma:"
        },
        {
          "number": 176,
          "text": "Reduzi sem danos"
        },
        {
          "number": 177,
          "text": "A fôrmas a forma."
        },
        {
          "number": 178,
          "text": "Clame a saparia"
        },
        {
          "number": 179,
          "text": "Em críticas céticas:"
        },
        {
          "number": 180,
          "text": "Não há mais poesia,"
        },
        {
          "number": 181,
          "text": "Mas há artes poéticas…”"
        },
        {
          "number": 182,
          "text": "Urra o sapo-boi:"
        },
        {
          "number": 183,
          "text": "– “Meu pai foi rei!”- “Foi!”"
        },
        {
          "number": 184,
          "text": "– “Não foi!” – “Foi!” – “Não foi!”."
        },
        {
          "number": 185,
          "text": "Brada em um assomo"
        },
        {
          "number": 186,
          "text": "O sapo-tanoeiro:"
        },
        {
          "number": 187,
          "text": "– “A grande arte é como"
        },
        {
          "number": 188,
          "text": "Lavor de joalheiro."
        },
        {
          "number": 189,
          "text": "Ou bem de estatuário."
        },
        {
          "number": 190,
          "text": "Tudo quanto é belo,"
        },
        {
          "number": 191,
          "text": "Tudo quanto é vário,"
        },
        {
          "number": 192,
          "text": "Canta no martelo”."
        },
        {
          "number": 193,
          "text": "Outros, sapos-pipas"
        },
        {
          "number": 194,
          "text": "(Um mal em si cabe),"
        },
        {
          "number": 195,
          "text": "Falam pelas tripas,"
        },
        {
          "number": 196,
          "text": "– “Sei!” – “Não sabe!” – “Sabe!”."
        },
        {
          "number": 197,
          "text": "Longe dessa grita,"
        },
        {
          "number": 198,
          "text": "Lá onde mais densa"
        },
        {
          "number": 199,
          "text": "A noite infinita"
        },
        {
          "number": 200,
          "text": "Veste a sombra imensa;"
        },
        {
          "number": 201,
          "text": "Lá, fugido ao mundo,"
        },
        {
          "number": 202,
          "text": "Sem glória, sem fé,"
        },
        {
          "number": 203,
          "text": "No perau profundo"
        },
        {
          "number": 204,
          "text": "E solitário, é"
        },
        {
          "number": 205,
          "text": "Que soluças tu,"
        },
        {
          "number": 206,
          "text": "Transido de frio,"
        },
        {
          "number": 207,
          "text": "Sapo-cururu"
        },
        {
          "number": 208,
          "text": "Da beira do rio…"
        },
        {
          "number": null,
          "text": "BANDEIRA, Manuel. Os sapos. In: Estrela da Vida Inteira."
