# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Saídas regeneráveis do banco de questões.
# Apenas o acervo curado de provas/gabaritos é versionado para auditoria e
# reprodução. Outros arquivos em UECE/ permanecem locais. Os JSONL gerados da
# V1 são versionados para consumo direto pelo frontend.
/UECE/*
!/UECE/VESTIBULAR UECE_/
!/UECE/VESTIBULAR UECE_/1 PROVAS E GABARITOS/
!/UECE/VESTIBULAR UECE_/1 PROVAS E GABARITOS/**

# Recortes PNG são usados apenas na auditoria manual local por enquanto.
/question-bank/data/assets/
/.uv-cache-question-bank
/.venv-question-bank

# next.js
/.next/
/out/

# production
/build
/.tmp-pdf-tools

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
